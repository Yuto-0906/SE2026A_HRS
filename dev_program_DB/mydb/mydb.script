CREATE SCHEMA PUBLIC AUTHORIZATION DBA
CREATE MEMORY TABLE PAYMENT(ROOMNUMBER VARCHAR(50) NOT NULL,STAYINGDATE VARCHAR(20) NOT NULL,AMOUNT INTEGER,STATUS VARCHAR(10),CONSTRAINT ROOMNUMBER_STAYINGDATE PRIMARY KEY(ROOMNUMBER,STAYINGDATE))
CREATE MEMORY TABLE AVAILABLEQTY(DATE VARCHAR(20) NOT NULL PRIMARY KEY,QTY INTEGER)
CREATE MEMORY TABLE RESERVATION(RESERVATIONNUMBER VARCHAR(50) NOT NULL PRIMARY KEY,STAYINGDATE VARCHAR(20),STATUS VARCHAR(10))
CREATE MEMORY TABLE ROOM(ROOMNUMBER VARCHAR(50) NOT NULL PRIMARY KEY,STAYINGDATE VARCHAR(20))
CREATE MEMORY TABLE USERS(USER_ID VARCHAR(50) NOT NULL PRIMARY KEY,NAME VARCHAR(100) NOT NULL,PHONE VARCHAR(30) NOT NULL)
CREATE MEMORY TABLE ROOMS(ROOM_NUMBER VARCHAR(20) NOT NULL PRIMARY KEY)
CREATE MEMORY TABLE RESERVATIONS(RESERVATION_NUMBER VARCHAR(50) NOT NULL PRIMARY KEY,USER_ID VARCHAR(50) NOT NULL,ROOM_NUMBER VARCHAR(20) NOT NULL,RESERVED_AT TIMESTAMP NOT NULL,CHECK_IN_DATE DATE NOT NULL,STATUS VARCHAR(20) NOT NULL,CONSTRAINT FK_RESERVATION_USER FOREIGN KEY(USER_ID) REFERENCES USERS(USER_ID),CONSTRAINT FK_RESERVATION_ROOM FOREIGN KEY(ROOM_NUMBER) REFERENCES ROOMS(ROOM_NUMBER),CONSTRAINT CK_RESERVATION_STATUS CHECK(RESERVATIONS.STATUS IN ('RESERVED','CHECKED_IN','CHECKED_OUT','CANCELED')))
CREATE MEMORY TABLE ROOM_ALLOCATIONS(ROOM_NUMBER VARCHAR(20) NOT NULL,CHECK_IN_DATE DATE NOT NULL,RESERVATION_NUMBER VARCHAR(50) NOT NULL,CONSTRAINT PK_ROOM_ALLOCATION PRIMARY KEY(ROOM_NUMBER,CHECK_IN_DATE),CONSTRAINT UQ_ALLOCATION_RESERVATION UNIQUE(RESERVATION_NUMBER),CONSTRAINT FK_ALLOCATION_ROOM FOREIGN KEY(ROOM_NUMBER) REFERENCES ROOMS(ROOM_NUMBER),CONSTRAINT FK_ALLOCATION_RESERVATION FOREIGN KEY(RESERVATION_NUMBER) REFERENCES RESERVATIONS(RESERVATION_NUMBER))
CREATE USER SA PASSWORD ""
GRANT DBA TO SA
SET WRITE_DELAY 10
SET SCHEMA PUBLIC
